# URL-encode special characters in the password, e.g. $ becomes %24.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/?appName=APP_NAME
MONGODB_DB=DATABASE_NAME
CHALLONGE_API_KEY=

# Public production URL, used for canonical links, sitemap, manifest, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.byleandro.space

# Optional: set to enable Google Analytics 4 (loads only after a visitor accepts
# analytics cookies in the consent banner).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
